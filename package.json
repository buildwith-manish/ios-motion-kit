{
  "name": "ios-motion-kit",
  "version": "0.2.0",
  "private": true,
  "description": "Reusable iOS-style motion kit for Remotion: tokens, glass, text, dataviz, transitions, camera, audio, qa.",
  "scripts": {
    "dev": "remotion studio src/index.ts --port=3000 --ipv4 --no-open",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "kit:contrast": "node scripts/kit_contrast_tokens.mjs",
    "kit:sizeguard": "node scripts/kit_size_guard.mjs",
    "kit:init": "node scripts/kit_init.mjs",
    "kit:new-video": "node scripts/new-video.mjs",
    "kit:data-check": "node scripts/kit_data_check.mjs",
    "kit:layout-lint": "node scripts/kit_layout_lint.mjs",
    "kit:fetch-data": "node scripts/kit_fetch_data.mjs",
    "kit:data-manifest": "node scripts/kit_data_manifest.mjs",
    "kit:audio": "python3 scripts/kit_make_music.py",
    "kit:shrink-previews": "bash scripts/kit_shrink_previews.sh",
    "test:unit": "vitest run",
    "test:visual": "node scripts/kit-visual-regression.mjs",
    "test:visual:update": "node scripts/kit-visual-regression.mjs --update",
    "kit:sfx-report": "python3 scripts/sfx_report.py && python3 scripts/sfx_build_page.py",
    "kit:vo-layout": "python3 scripts/pipeline/vo_layout.py",
    "kit:vo-words": "python3 scripts/pipeline/vo_words.py",
    "kit:vo-envelope": "python3 scripts/pipeline/vo_envelope.py",
    "kit:vo-normalize": "python3 scripts/pipeline/normalize_vo.py",
    "kit:pace-audit": "python3 scripts/pipeline/pace_audit.py",
    "kit:tts-prep": "python3 scripts/pipeline/tts_prep.py",
    "kit:config-check": "node scripts/pipeline/config_check.mjs",
    "kit:figures-check": "node scripts/pipeline/figures_check.mjs",
    "kit:chapters": "node scripts/pipeline/chapters.mjs",
    "kit:chapters-check": "node scripts/pipeline/chapters_check.mjs",
    "kit:mix-check": "python3 scripts/pipeline/mix_check.py",
    "kit:normalize": "python3 scripts/pipeline/normalize_final.py",
    "kit:review": "node scripts/kit_review.mjs",
    "kit:contact-sheet": "node scripts/pipeline/contact_sheet.mjs",
    "kit:scene-stills": "node scripts/pipeline/scene_stills.mjs",
    "kit:dump-cues": "node scripts/pipeline/dump_cues.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@react-three/fiber": "8.17.10",
    "@remotion/bundler": "4.0.250",
    "@remotion/cli": "4.0.250",
    "@remotion/renderer": "4.0.250",
    "@remotion/three": "4.0.250",
    "d3-geo": "3.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.250",
    "three": "0.169.0",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^123.0.1",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.7",
    "@types/three": "0.169.0",
    "@types/topojson-client": "^3.1.5",
    "esbuild": "0.24.0",
    "mapshaper": "^0.6.117",
    "pixelmatch": "^6.0.0",
    "playwright-core": "1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
