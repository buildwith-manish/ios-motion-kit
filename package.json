{
  "name": "ios-motion-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable iOS-style motion kit for Remotion: tokens, glass, text, dataviz, transitions, camera, audio, qa.",
  "scripts": {
    "dev": "remotion studio src/index.ts --port=3000 --ipv4 --no-open",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "kit:contrast": "node scripts/kit_contrast_tokens.mjs",
    "test:unit": "vitest run",
    "test:visual": "node scripts/kit-visual-regression.mjs",
    "test:visual:update": "node scripts/kit-visual-regression.mjs --update"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.250",
    "@remotion/cli": "4.0.250",
    "@remotion/renderer": "4.0.250",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.250"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^123.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.7",
    "esbuild": "0.24.0",
    "pixelmatch": "^6.0.0",
    "playwright-core": "1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
