{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "ios-motion-kit": ["kit/src/kit"],
      "ios-motion-kit/*": ["kit/src/kit/*"]
    }
  },
  "include": ["src", "data"]
}
